#include "VendorErrandPolicy.h"
#include <array>
#include <cassert>
#include <ctime>
#include <limits>
#include <map>
#include <vector>

namespace V = VendorErrandPolicy;

// Only core/AI boundaries are doubles; release protection and the sale gate are
// the production functions included by the test runner.
constexpr int ITEM_QUALITY_POOR = 0, ITEM_CLASS_QUEST = 1, ITEM_CLASS_CONTAINER = 2, ITEM_CLASS_QUIVER = 3;
using uint32 = unsigned;
using ObjectGuid = unsigned;
constexpr uint32 BUYBACK_SLOT_START = 0, BUYBACK_SLOT_END = 3;
struct Item;
struct Session;
struct Player
{
    unsigned questNeeds = 0;
    std::array<Item*, 3> bags{};
    std::array<Item*, 3> buyback{};
    Session* session = nullptr;
    ObjectGuid GetGUID() const { return 2; }
    Item* GetItemByGuid(ObjectGuid guid) const;
    static bool IsInventoryPos(unsigned pos) { return pos < 3; }
    Item* GetItemFromBuyBackSlot(uint32 slot) const { return buyback[slot]; }
    Session* GetSession() const { return session; }
};
bool QuestNeedsItem(Player const* player, unsigned entry) { return player->questNeeds == entry; }
struct ItemTemplate { int Quality = 0, SellPrice = 1, Class = 0; unsigned StartQuest = 0, ItemId = 42; };
struct Item
{
    ItemTemplate const* proto;
    bool trading = false, refundable = false;
    ObjectGuid guid = 1;
    unsigned pos = 0;
    ItemTemplate const* GetTemplate() const { return proto; }
    bool IsInTrade() const { return trading; }
    bool IsRefundable() const { return refundable; }
    ObjectGuid GetGUID() const { return guid; }
    ObjectGuid GetOwnerGUID() const { return 2; }
    unsigned GetPos() const { return pos; }
};
Item* Player::GetItemByGuid(ObjectGuid guid) const
{
    for (Item* item : bags)
        if (item && item->GetGUID() == guid)
            return item;
    return nullptr;
}
enum ItemUsage { ITEM_USAGE_NONE, ITEM_USAGE_VENDOR };
struct Verdict
{
    ItemUsage current = ITEM_USAGE_VENDOR;
    ItemUsage Get() const { return current; }
};
struct PlayerbotAI
{
    Verdict verdict;
    PlayerbotAI* GetAiObjectContext() { return this; }
    template<class T> Verdict* GetValue(char const*, unsigned) { return &verdict; }
};
PlayerbotAI realVerdict;
PlayerbotAI* botAI = &realVerdict;
#define MOD_PLAYERBOTS
#define GET_PLAYERBOT_AI(bot) (botAI)
@@RELEASE@@
@@JUNK@@

constexpr unsigned CMSG_SELL_ITEM = 0;
struct WorldPacket { unsigned op; };
namespace WorldPackets::Item
{
    struct SellItem { WorldPacket packet; ObjectGuid VendorGuid = 0, ItemGuid = 0; unsigned Count = 1; };
}
struct Session
{
    Player& bot;
    std::vector<ObjectGuid> attempted{};
    bool& saleReady;
    bool invalidateAuthority = false;
    bool decline = false;
    void HandleSellItemOpcode(WorldPackets::Item::SellItem& packet)
    {
        assert(packet.VendorGuid == 11 && packet.Count == 0);
        attempted.push_back(packet.ItemGuid);
        if (decline)
            return;
        Item* item = bot.GetItemByGuid(packet.ItemGuid);
        assert(item);
        bot.bags[item->pos] = nullptr;
        bot.buyback[item->pos] = item;
        if (invalidateAuthority)
            saleReady = false;
        bot.bags[1] = nullptr; // another stack disappears in the native callback
    }
};
struct VendorErrand { uint32 botGuid; ObjectGuid vendor; };
Player* saleBot = nullptr;
Player* saleOwner = nullptr;
bool saleReady = false;
std::map<uint32, uint32> g_sellAt;
Player* FindCompanionPlayer(uint32 guid) { return guid == 2 ? saleBot : nullptr; }
Player* FindDeliveryOwner(uint32 guid) { return guid == 1 ? saleOwner : nullptr; }
bool ReadyVendorErrandSale(uint32, Player* owner, Player* bot, VendorErrand const& errand)
{
    return saleReady && owner && bot && errand.vendor == 11;
}
bool ManagedSaleDue(Player*, uint32) { return true; }
template<class Visit> void VisitCarriedItems(Player* bot, Visit visit)
{
    for (Item* item : bot->bags)
        if (item)
            visit(item);
}
@@SALE@@

int main()
{
    // A sample is only settled at the same location and in the same world instance.
    V::Stop const stop{1, 7, {0, 0, 0}};
    assert(V::SameStop(stop, {1, 7, {0.05f, 0, 0}}));
    assert(!V::SameStop(stop, {2, 7, {0, 0, 0}}));
    assert(!V::SameStop(stop, {1, 8, {0, 0, 0}}));
    assert(!V::SameStop(stop, {1, 7, {0, 0, 0.2f}}));
    assert(!V::MayStart(8, true));
    assert(V::MayStart(7, true));
    assert(!V::MayStart(7, false)); // another companion has the owner's lease

    V::Point const owner{0, 0, 0}, start{3, 0, 0}, vendor{9, 0, 0};
    auto const route = std::array{start, V::Point{6, 2, 0}, vendor};
    assert(V::IsBoundedPath(route, start, owner, vendor));
    assert(!V::IsBoundedPath(std::array{start}, start, owner, vendor));
    assert(!V::IsBoundedPath(std::array{start, V::Point{7, 0, 0}}, start, owner, vendor));
    assert(!V::IsBoundedPath(std::array{V::Point{4.1f, 0, 0}, vendor}, start, owner, vendor));
    assert(!V::IsBoundedPath(std::array{start, V::Point{6, 11, 0}, vendor}, start, owner, vendor));
    assert(!V::IsBoundedPath(std::array{start, V::Point{-8, 0, 0}, vendor}, start, owner, vendor));
    assert(!V::IsBoundedPath(std::array{start, V::Point{6, std::numeric_limits<float>::quiet_NaN(), 0}, vendor},
                            start, owner, vendor));

    using V::Step;
    assert(V::NextStep(true, true, false, false) == Step::Wait);
    assert(V::NextStep(true, true, true, true) == Step::Sell);
    assert(V::NextStep(true, true, true, false) == Step::Cancel); // stopped short
    assert(V::NextStep(false, true, true, true) == Step::Cancel); // unsafe even on arrival
    assert(V::NextStep(true, false, true, true) == Step::Cancel); // replacement movement

    // Cancel inside native interaction range, with a second merchant also usable.
    // The ordinary picker could choose either one; a per-target blacklist would fail.
    constexpr unsigned target = 11, alternate = 12;
    auto ordinaryMerchant = [&](bool leaseHeld, bool canceled, bool targetAvailable) {
        return V::AllowsOrdinarySale(leaseHeld, canceled) ? (targetAvailable ? target : alternate) : 0u;
    };
    assert(ordinaryMerchant(true, false, true) == 0);
    assert(V::NextStep(false, true, false, false) == Step::Cancel);
    assert(ordinaryMerchant(false, true, true) == 0);  // target is still in range
    assert(ordinaryMerchant(false, true, false) == 0); // target disappeared; alternate in range
    auto const botAtCancel = V::Stop{1, 7, {7, 0, 0}};
    auto const newOwnerStop = V::Stop{1, 7, {4, 0, 0}};
    auto const botAtNewStop = V::Stop{1, 7, {4, 0, 0}};
    V::CanceledWalk const canceled{stop, botAtCancel};
    assert(!V::MayRearm(canceled, stop, botAtCancel, true, true)); // no movement, regardless of time/config
    assert(!V::MayRearm(canceled, newOwnerStop, botAtCancel, true, true)); // bot stayed at the merchant
    assert(!V::MayRearm(canceled, newOwnerStop, botAtNewStop, false, true)); // owner has not settled
    assert(!V::MayRearm(canceled, newOwnerStop, botAtNewStop, true, false)); // bot has not settled into normal follow
    assert(V::MayRearm(canceled, newOwnerStop, botAtNewStop, true, true));
    assert(ordinaryMerchant(false, false, false) == alternate); // native fallback only after rearm, or no errand

    Player human, follower;
    ItemTemplate proto;
    Item item{&proto};
    auto canSell = [&] { return IsManagedVendorJunk(&human, &follower, &item); };
    assert(canSell());
    human.questNeeds = proto.ItemId;
    assert(!canSell()); // new quest between departure and arrival
    human.questNeeds = 0;
    follower.questNeeds = proto.ItemId;
    assert(!canSell());
    follower.questNeeds = 0;
    realVerdict.verdict.current = ITEM_USAGE_NONE;
    assert(!canSell()); // AI changed its mind between checks
    realVerdict.verdict.current = ITEM_USAGE_VENDOR;
    for (int protectedClass : {ITEM_CLASS_QUEST, ITEM_CLASS_CONTAINER, ITEM_CLASS_QUIVER})
    {
        proto.Class = protectedClass;
        assert(!canSell());
    }
    proto.Class = 0;
    proto.StartQuest = 1;
    assert(!canSell());
    proto.StartQuest = 0;
    item.trading = true;
    assert(!canSell());
    item.trading = false;
    item.refundable = true;
    assert(!canSell());
    item.refundable = false;
    proto.SellPrice = 0;
    assert(!canSell());
    proto.SellPrice = 1;
    proto.Quality = 1;
    assert(!canSell());
    proto.Quality = ITEM_QUALITY_POOR;
    botAI = nullptr;
    assert(!canSell());
    botAI = &realVerdict;
    assert(canSell());

    saleBot = &follower;
    saleOwner = &human;
    Session session{follower, {}, saleReady};
    follower.session = &session;
    Item second{&proto, false, false, 2, 1}, third{&proto, false, false, 3, 2};
    VendorErrand const errand{2, target};
    follower.bags = {&item, &second, &third};
    saleReady = true;
    bool completed = false;
    assert(SellVendorErrandJunk(1, errand, completed) == 2);
    assert((session.attempted == std::vector<ObjectGuid>{1, 3})); // stale second stack never dispatched
    assert(completed);

    follower.bags = {&item, &second, &third};
    follower.buyback = {};
    session.attempted.clear();
    session.invalidateAuthority = true;
    completed = false;
    assert(SellVendorErrandJunk(1, errand, completed) == 1);
    assert((session.attempted == std::vector<ObjectGuid>{1})); // authority loss stops before the third stack
    assert(!completed);

    follower.bags = {&item, &second, &third};
    follower.buyback = {};
    saleReady = true;
    session.attempted.clear();
    session.decline = true;
    assert(SellVendorErrandJunk(1, errand, completed) == 0);
    assert((session.attempted == std::vector<ObjectGuid>{1})); // no alternate-merchant fallback on native refusal
    assert(!completed);
}

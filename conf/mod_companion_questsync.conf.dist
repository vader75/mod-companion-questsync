[worldserver]
########################################################################
# COMPANION QUEST SYNC
#
# Keeps tracked QuestSync companions in step with their owner's eligible
# quests and, optionally, level. Ownership uses reviewed companion custody.
#
# Companion trade offers require the AzerothCore guard patch; named supply
# orders also require the receipt patch. See the repository README.
#
#    CompanionQuestSync.Enable
#        1 = the module is active at all (command included).
#        0 = fully inert; nothing is read and no command is registered.
#        Default: 1
#
#    CompanionQuestSync.AutoSync
#        1 = reconcile every companion on a timer (see IntervalSeconds).
#        0 = only the manual ".companionsync" command syncs.
#        Default: 1
#
#    CompanionQuestSync.IntervalSeconds
#        Seconds between automatic reconciliation passes. Each pass is cheap
#        (one binding lookup + one quest-log walk per online player).
#        Default: 30
#
#    CompanionQuestSync.LevelMode
#        0 = never touch the companion's level.
#        1 = raise the companion to the owner's level (never lower it).
#        2 = make the companion exactly the owner's level (raise and lower).
#        Quests gate on quest_template.MinLevel, so a companion below its
#        owner's level simply cannot take the owner's quests - this is the
#        switch that fixes that. Raising a companion can make its own quests
#        grey, which mod-playerbots may drop; this module re-adds them on the
#        next pass.
#        Default: 1
#
#    CompanionQuestSync.SyncCompletion
#        1 = when the owner finishes, recheck the companion's own objectives and
#            finish its copy only if the core allows it. No objective credit is copied.
#        0 = leave the companion's progress alone.
#        Default: 1
#
#    CompanionQuestSync.ForceAccept
#        0 = respect the core's eligibility rules (CanTakeQuest: level, class,
#            race, reputation, prerequisite chain, conditions). A quest the
#            companion is not eligible for is reported and skipped.
#        1 = bypass those rules and insert the quest anyway (Player::AddQuest).
#            Use only to work around a broken chain; the companion may then
#            hold a quest it cannot complete.
#        Default: 0
#
#    CompanionQuestSync.DropExtraBotQuests
#        1 = delete companion quests the owner does not have, so the two logs
#            match exactly. Destructive: this also removes the companion's own
#            quests (class, profession, its own pickups).
#        0 = keep them; the owner's quests are still added on top.
#        Default: 1
#
#    CompanionQuestSync.RequireGrouped
#        1 = only sync QUEST LOGS while the companion is in the owner's group
#            Bags, gear and level alignment always run, so a companion that
#            slipped out of the party is still kept healthy.
#        Default: 0
#
#    CompanionQuestSync.SkipInCombat
#        1 = do not LEVEL the companion while either side is in combat (a level
#            change re-gears the bot, so it waits for a quiet moment). Quest
#            copying is deliberately NOT gated by this: adding a quest or marking
#            one complete is safe in combat, and blocking it there is what made
#            pickups look slow.
#        Default: 1
#
#    CompanionQuestSync.SkipTimedQuests
#        1 = do not copy timed quests.
#        0 = share the owner's remaining whole seconds, subject to core timed-quest limits.
#        Default: 1
#
#    CompanionQuestSync.ExtraArmourSlots
#        Fill belt, bracers, gloves and cloak from a curated starter set that
#        matches the class's armour type (cloth, leather, mail). 0 leaves the
#        companion in the four core slots only.
#        Default: 1
#
#    CompanionQuestSync.PoolAccountType
#        The playerbots_account_type value that marks an AddClass body in the
#        pool. Change it only if the server reorganises those accounts.
#        Default: 2
#
#    Legacy and historical compatibility bindings always reserve their bodies.
#    The old RespectLegacyBindings setting is no longer used.
#
#    CompanionQuestSync.PoolTable
#        Historical QuestSync release ledger. Only cq_pool is read for
#        diagnostics; it is never used to grant custody or to repair a body.
#        Default: "cq_pool"
#
#    CompanionQuestSync.BindingTable
#        Character-database table holding owner_guid -> bot_guid. Custody
#        operations require the canonical cq_bindings table and the additive
#        companion-custody.sql migration.
#        Default: "cq_bindings"
#
#    CompanionQuestSync.NotifySkippedQuests
#        How much the companion whispers the owner about quests it could not
#        take. Repeats are suppressed per quest until it leaves and re-enters
#        the owner's log, so this cannot spam.
#        0 = silent
#        1 = class/race locks only (the refusals that are nobody's fault)
#        2 = every refusal - level, bags, quest cap, prerequisite, reputation
#        Default: 2 (a silent refusal reads as a broken sync)
#
#    CompanionQuestSync.Debug
#        0 = silent.
#        1 = log every added/completed/skipped quest to the server log, tagged
#            with the companion's name.
#        2 = the above, plus a heartbeat line per window (see HeartbeatSeconds):
#            passes, adds, completions, drops and whether the two logs line up.
#        Default: 0
#
#    CompanionQuestSync.TidyInventory
#        1 = warn about bag pressure and try an eligible merchant sale when
#            a quest pickup needs space. Bag cleanup never destroys items.
#        0 = disable this bag-pressure handling.
#        Default: 1
#
#    CompanionQuestSync.SellJunk
#        Sell eligible grey items rated as vendor junk by Playerbots.
#        Requires an interactable merchant. Without one, keep the items.
#        Default: 1
#
#    CompanionQuestSync.TrimSurplus
#        Once fewer than sixteen bag slots are free, a merchant visit sells the
#        SPARE trade goods (whole stacks only) back down to a profession budget:
#        one recipe's worth of a bought reagent, two stacks of a gathered material.
#        Professions keep what their recipes consume; quest items, containers and
#        bound gear are never sold. The companion says what it sold and why.
#        Default: 1
##    CompanionQuestSync.KeepFreeSlots
#        Free bag slots the tidy tries to restore (checked each pass and again
#        when an accept is refused for lack of space).
#        Default: 2
#

CompanionQuestSync.Enable = 1
CompanionQuestSync.AutoSync = 1
CompanionQuestSync.IntervalSeconds = 30
CompanionQuestSync.LevelMode = 1
CompanionQuestSync.SyncCompletion = 1
CompanionQuestSync.ForceAccept = 0
CompanionQuestSync.DropExtraBotQuests = 1

#    CompanionQuestSync.DropExtraGraceSeconds
#        Description: How long a companion keeps a quest the owner does not have before
#                     treating it as abandoned. Covers the gap between the owner
#                     accepting a quest and it reaching the companion.
#        Default:     120
CompanionQuestSync.DropExtraGraceSeconds = 120
#    CompanionQuestSync.PinSync
#        Description: Keep the client addon's map reconciled with the companion.
#                     Each pass sends one authoritative line - "Pin sync 3:
#                     43,65,h=Kobold Candles|..." - split across several whispers when
#                     there are too many entries for one, and the addon rebuilds its
#                     pins from it. Any pin it does not mention is removed, which is
#                     what cleans the map after a lost whisper or a session that ended
#                     mid hand-in. Sent on login, on change, every ten minutes, and on
#                     demand with .companionsync pins.
#        Default:     1 (on)
CompanionQuestSync.PinSync = 1
#    CompanionQuestSync.PinSyncSeconds
#        Description: Longest gap between identical pin-sync lines. The line is also
#                     re-sent whenever its contents change, so this is only the safety
#                     net for a whisper the client never received.
#        Default:     600
CompanionQuestSync.PinSyncSeconds = 600
#    CompanionQuestSync.CatchUpGroundItems
#        Description: Not every collection quest drops from a body. "Milly's Harvest"
#                     needs eight handfuls of oats, and they are chests standing in a
#                     field: the companion steps to them and loots them like any other
#                     object. When the world will not co-operate - another player took the
#                     node, a spawn the bot cannot reach - this lets it take the items it
#                     still owes, so the quest does not sit at 0/8 forever.
#                     Only items that lie on the ground are ever granted, so a
#                     kill-collect quest cannot be finished this way, and only for a
#                     quest the owner has already been rewarded (the companion is
#                     catching up, not running ahead). The manual Ground quests
#                     button and .companionsync catchup are separate actions.
#        Default:     0 (off; normal gathering consumes actual world loot)
CompanionQuestSync.CatchUpGroundItems = 0
#    CompanionQuestSync.CatchUpIdleSeconds
#        Description: How long the companion's count for a ground quest must sit still
#                     before it finishes the quest itself. The gather step keeps trying
#                     every pass; this is the patience it gets first.
#        Default:     120
CompanionQuestSync.CatchUpIdleSeconds = 120
#    CompanionQuestSync.FollowThroughTeleport
#        Description: Take the companion with you when you teleport - a hearthstone, a
#                     portal, a summon. Without it the companion stays where it stood and is
#                     in another zone by the time you land. Walking away never teleports it;
#                     only a real teleport does, and never into a battleground or arena.
#        Default:     1 (on)
CompanionQuestSync.FollowThroughTeleport = 1
#    CompanionQuestSync.HandInMode
#        Description: How a finished quest is handed in.
#                     0 = disable module hand-ins.
#                     1 = use native turn-in with a live, interactable quest ender.
#                     2 = like mode 1, with a reminder to lead the companion to the ender.
#        Default:     1
CompanionQuestSync.HandInMode = 1
# Mode 2 uses this distance for reminders; it does not extend interaction range.
CompanionQuestSync.HandInNearDistance = 40
#    CompanionQuestSync.HandInDelaySeconds
#        Description: How long a finished quest stays visible before it rewards itself.
#                     The gold hand-in pin and the companion standing at the giver are the
#                     visible half of an instant hand-in - without this pause the quest
#                     completes and rewards within one tick, and the player only ever sees
#                     the aftermath. 0 rewards immediately.
#        Default:     20
CompanionQuestSync.HandInDelaySeconds = 20

#    CompanionQuestSync.DropFailedBotQuests
#        Description: Drop a companion quest its own AI failed (a dead escort, a timed
#                     script). The owner is told once either way; with this on, the copy
#                     is also removed so the two logs can line up again.
#        Default:     0 (report only)
CompanionQuestSync.DropFailedBotQuests = 0
CompanionQuestSync.RequireGrouped = 0

# May this module mint a companion from the playerbots pool itself?
# Claims an independently reviewed, clean custody body. No reset runs on claim.
# Set to 0 to disable player-side creation.
CompanionQuestSync.AllowCreate = 1
CompanionQuestSync.SkipInCombat = 1
CompanionQuestSync.SkipTimedQuests = 1
CompanionQuestSync.BindingTable = "cq_bindings"
CompanionQuestSync.PoolTable = "cq_pool"
CompanionQuestSync.ExtraArmourSlots = 1
CompanionQuestSync.PoolAccountType = 2
CompanionQuestSync.NotifySkippedQuests = 2
CompanionQuestSync.TidyInventory = 1
#    CompanionQuestSync.MailHome
#        At a reachable mailbox, send a small parcel of clear armor upgrades or
#        requested supplies. Never sends general overflow. 0 = no automatic mail.
CompanionQuestSync.MailHome = 1
CompanionQuestSync.KeepFreeSlots = 2
# Try an eligible merchant sale when a quest pickup needs bag space.
CompanionQuestSync.BagMargin = 8
CompanionQuestSync.SellJunk = 1
# Sell spare trade goods (whole stacks) at a merchant once fewer than 16 bag slots
# are free, keeping one recipe's worth of reagents and two stacks of any material.
CompanionQuestSync.TrimSurplus = 1
CompanionQuestSync.MapPins = 1
# The land asks a minimum of its gatherers: on entering a zone, a companion whose
# gathering skill sits below the zone asks (~5 points per zone level) is caught up to
# that minimum once, with one line in chat. Organically-gathered skill is never reduced.
CompanionQuestSync.GatherCatchUp = 1

#    Near a trade or repair NPC the companion tops up the shop-bought reagents its
#    known recipes ask (vials, threads, coal) to a small stock, and a repairer's
#    hammer mends its gear at the usual price. At most once every five minutes per
#    companion, announced with one quiet line. 0 = never restock.
CompanionQuestSync.VendorRestock = 1

#    Crafting runs on its own every three minutes per companion, outside combat:
#    it turns what its gathering paid for into its products, silently - bags,
#    use in play, curated surplus delivery. The Produce button still gives the
#    report on demand. 0 = craft only when asked.
CompanionQuestSync.AutoProduce = 1

#    Offer clear upgrades and requested supplies at stationary, out-of-combat
#    town stops, at most once every ten minutes per owner. 0 = manual trade only.
CompanionQuestSync.AutoTrade = 1
CompanionQuestSync.ExtraBagItem = 20400
CompanionQuestSync.ExtraBags = 4


#    CompanionQuestSync.ExtraBagItem / ExtraBags
#        Ordinary upkeep: any empty bag slot is filled
#        once with ExtraBagItem (default Pumpkin Bag, 16 slots, no level requirement),
#        up to ExtraBags slots. A slot that is already occupied is never touched, so a
#        bag the player gave the companion stays. 0 for either disables it.
#        51809 is not allowed here: Portable Holes are a separate one-time
#        starter grant for new claims with the Playerbots initialization policy
#        patch and companion-starter-bags.sql installed (see docs/companion-custody.md).
#

#    CompanionQuestSync.MapPins
#        Enable companion map pins (requires CompanionPins and PinSync) and nearby
#        movement assistance. Native quest-giver icons show the player's own quests.
#        Default: 1
#
#    Older TidyVendorJunk, TidySurplus and ItemKeepQuality settings are ignored.
#    Automatic cleanup no longer destroys items.
CompanionQuestSync.AnnounceAtStartup = 1
CompanionQuestSync.AnnounceOnLogin = 1
CompanionQuestSync.HeartbeatSeconds = 300
CompanionQuestSync.Debug = 0


+#ifndef PLAYERBOT_INITIALIZATION_POLICY_H
+#define PLAYERBOT_INITIALIZATION_POLICY_H
+
+#include <cstdint>
+
+#define MOD_PLAYERBOTS_INITIALIZATION_POLICY_V1 1
+
+namespace Playerbots
+{
+// Optional process-lifetime provider, registered while module scripts load.
+// The callback must be thread-safe; true vetoes native randomization and bag init.
+using InitializationVeto = bool (*)(std::uint32_t bodyGuid);
+bool RegisterInitializationVeto(InitializationVeto veto);
+bool ShouldDeferInitialization(std::uint32_t bodyGuid);
+}
+
+#endif

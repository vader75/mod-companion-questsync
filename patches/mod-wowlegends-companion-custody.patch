diff --git a/tests/test_companion_lifecycle.py b/tests/test_companion_lifecycle.py
new file mode 100644
index 0000000..31e9c80
--- /dev/null
+++ b/tests/test_companion_lifecycle.py
@@ -0,0 +1,29 @@
+from pathlib import Path
+import unittest
+
+SRC = (Path(__file__).resolve().parents[1] / 'src/wowlegends_companion.cpp').read_text(encoding='utf-8')
+
+
+class Lifecycle(unittest.TestCase):
+    def test_pool_selection_and_claim_share_custody_guard(self):
+        picker = SRC.split('uint32 PickPoolChar(', 1)[1].split('void DispatchPlayerbots', 1)[0]
+        self.assertIn('FreeCustodyClause', picker)
+        claim = SRC.split('static bool ClaimBody(', 1)[1].split('static bool SummonBody(', 1)[0]
+        self.assertIn('FreeCustodyClause', claim)
+        self.assertIn('DirectCommitTransaction', claim)
+        self.assertNotIn('ResetPoolBody', claim)
+
+    def test_historical_repair_has_no_body_write_path(self):
+        self.assertNotIn('RepairReleasedNames', SRC)
+        self.assertNotIn('ReconcileBindings', SRC)
+        self.assertNotIn('UPDATE characters SET at_login', SRC)
+
+    def test_forget_and_destroy_do_not_recycle_while_world_is_running(self):
+        self.assertNotIn('QueueBodyReset', SRC)
+        self.assertNotIn('ResetPoolBody', SRC)
+        self.assertIn('RequestRetirement(handler,', SRC)
+
+    def test_legacy_memory_does_not_follow_unverified_bindings(self):
+        memory = (Path(__file__).resolve().parents[1] / "src/wowlegends_companion.cpp").with_name('wowlegends_companion_memory.cpp').read_text(encoding='utf-8')
+        self.assertIn('WlVerifiedCompanionOwner(botGuid)', memory)
+        self.assertIn('WlVerifiedCompanionBody(ownerGuid)', memory)

+++ b/src/server/game/Entities/Player/CompanionLootPolicy.h
@@ -0,0 +1,16 @@
+#ifndef AC_COMPANION_LOOT_POLICY_H
+#define AC_COMPANION_LOOT_POLICY_H
+
+#include "Define.h"
+
+class Player;
+
+namespace CompanionLootPolicy
+{
+    using Veto = bool (*)(Player*, uint32);
+
+    // Installed at script registration, before any map update can store loot.
+    inline Veto VetoNewStack = nullptr;
+}
+
+#endif
